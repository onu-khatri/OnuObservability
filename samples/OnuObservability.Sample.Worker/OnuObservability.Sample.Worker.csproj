<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-OnuObservability.Sample.Worker-c4c066ef-cdb8-4a35-a9ad-6d59f76af4dc</UserSecretsId>
    <IsSampleProject>true</IsSampleProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalPackages)' != 'true'">
    <ProjectReference Include="..\..\src\OnuObservability.Hosting\OnuObservability.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalPackages)' == 'true'">
    <PackageReference Include="OnuObservability.Hosting" VersionOverride="[$(OnuObservabilityPackageVersion)]" />
  </ItemGroup>
</Project>
