{
  "OnuObservability": {
    "Enabled": true,
    "ExporterEnabled": false,
    "ServiceName": "onu-mcp-sample",
    "ServiceNamespace": "samples",
    "ServiceVersion": "1.0.0",
    "DeploymentEnvironment": "local",
    "LocalJsonLoggingEnabled": true,
    "Mcp": {
      "StdioSafeLogging": true,
      "MaximumInputItems": 256,
      "MaximumOutputItems": 256
    }
  },
  "Logging": {
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  }
}
