{
  "OnuObservability": {
    "Enabled": true,
    "ExporterEnabled": false,
    "ServiceName": "onu-web-sample",
    "ServiceNamespace": "samples",
    "ServiceVersion": "1.0.0",
    "DeploymentEnvironment": "local",
    "LocalJsonLoggingEnabled": true,
    "AspNetCore": {
      "MaximumRouteTemplates": 1024,
      "ExcludedRouteTemplates": [ "/health", "/ready" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  }
}
